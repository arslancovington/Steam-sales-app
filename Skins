const fs = require('fs');
const path = require('path');

const INPUT_FILE = path.join(__dirname, 'steam-inventory.json');
const OUTPUT_FILE = path.join(__dirname, 'user-inventory-db.js');

const FALLBACK_IMAGE = '[dummyimage.com](https://dummyimage.com/360x360/101614/7cfc00&text=No+Image)';

function readJson(filePath) {
  if (!fs.existsSync(filePath)) {
    throw new Error(`Файл не найден: ${filePath}`);
  }

  const raw = fs.readFileSync(filePath, 'utf8');
  return JSON.parse(raw);
}

function normalizeName(name) {
  return String(name || '')
    .replace(/\s+/g, ' ')
    .trim();
}

function buildImageUrl(iconUrl) {
  if (!iconUrl) return FALLBACK_IMAGE;

  if (/^https?:\/\//i.test(iconUrl)) {
    return iconUrl;
  }

  return `[community.cloudflare.steamstatic.com](https://community.cloudflare.steamstatic.com/economy/image/${iconUrl}/360fx360f)`;
}

function buildDescriptionMap(descriptions) {
  const map = new Map();

  for (const item of descriptions) {
    const key = `${item.classid || ''}_${item.instanceid || ''}`;
    map.set(key, item);
  }

  return map;
}

function extractItems(inventoryData) {
  const assets = Array.isArray(inventoryData.assets) ? inventoryData.assets : [];
  const descriptions = Array.isArray(inventoryData.descriptions) ? inventoryData.descriptions : [];

  const descriptionMap = buildDescriptionMap(descriptions);
  const result = {};

  for (const asset of assets) {
    const key = `${asset.classid || ''}_${asset.instanceid || ''}`;
    const desc = descriptionMap.get(key);

    if (!desc) continue;

    const marketHashName = normalizeName(
      desc.market_hash_name || desc.market_name || desc.name || ''
    );

    if (!marketHashName) continue;

    if (!result[marketHashName]) {
      result[marketHashName] = {
        name: normalizeName(desc.name || marketHashName),
        marketHashName,
        image: buildImageUrl(desc.icon_url_large || desc.icon_url),
        iconUrl: desc.icon_url_large || desc.icon_url || '',
        count: 0,
        tradable: desc.tradable !== 0,
        marketable: desc.marketable !== 0,
        commodity: Boolean(desc.commodity),
        nameColor: desc.name_color || '',
        type: desc.type || '',
        ids: []
      };
    }

    result[marketHashName].count += 1;
    result[marketHashName].ids.push({
      assetid: asset.assetid || '',
      classid: asset.classid || '',
      instanceid: asset.instanceid || '',
      amount: asset.amount || '1'
    });
  }

  return result;
}

function buildClientFile(db) {
  return `window.USER_STEAM_INVENTORY_DB = ${JSON.stringify(db, null, 2)};

window.getUserInventoryItem = function(marketHashName) {
  return window.USER_STEAM_INVENTORY_DB.items[marketHashName] || null;
};

window.hasUserItem = function(marketHashName) {
  return Boolean(window.USER_STEAM_INVENTORY_DB.items[marketHashName]);
};

window.attachUserInventoryImages = function(items) {
  if (!Array.isArray(items)) return [];

  return items.map(function(item) {
    const key = item.marketHashName || item.name;
    const invItem = window.USER_STEAM_INVENTORY_DB.items[key];

    if (!invItem) {
      return {
        ...item,
        image: item.image || window.USER_STEAM_INVENTORY_DB.meta.fallbackImage,
        inUserInventory: false,
        inventoryCount: 0
      };
    }

    return {
      ...item,
      image: item.image || invItem.image,
      inUserInventory: true,
      inventoryCount: invItem.count,
      tradable: item.tradable ?? invItem.tradable,
      marketable: item.marketable ?? invItem.marketable
    };
  });
};
`;
}

function main() {
  const inventoryData = readJson(INPUT_FILE);

  const items = extractItems(inventoryData);

  const db = {
    meta: {
      generatedAt: new Date().toISOString(),
      totalUniqueItems: Object.keys(items).length,
      fallbackImage: FALLBACK_IMAGE
    },
    items
  };

  const clientFile = buildClientFile(db);
  fs.writeFileSync(OUTPUT_FILE, clientFile, 'utf8');

  console.log('Готово: user-inventory-db.js создан');
  console.log('Уникальных предметов:', db.meta.totalUniqueItems);
}

main();
