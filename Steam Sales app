<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Steam Sales Web App</title>
    <!-- Подключение библиотеки Telegram Web Apps -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');

        :root {
            --bg-dark: #0a0f14;
            --bg-card: #121921;
            --neon-green: #4ade80; /* Мягкий неоновый зеленый */
            --neon-glow: rgba(74, 222, 128, 0.3);
            --text-light: #ffffff;
            --text-muted: #8b96a5;
            --border-radius: 12px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            padding: 16px;
            /* Фоновый градиент для имитации свечения на фоне */
            background-image: radial-gradient(circle at 0% 50%, rgba(74, 222, 128, 0.05) 0%, transparent 50%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Шапка */
        .header {
            margin-bottom: 20px;
        }

        .title {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 16px;
        }

        /* Статистика */
        .stats-container {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat-box {
            flex: 1;
            background: var(--bg-card);
            border: 1px solid var(--neon-green);
            border-radius: var(--border-radius);
            padding: 12px;
            box-shadow: 0 0 15px var(--neon-glow);
        }

        .stat-title {
            font-size: 10px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .stat-value {
            font-size: 20px;
            font-weight: 800;
        }

        /* Фильтры и поиск */
        .controls {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
        }

        .search-input {
            flex: 1;
            background: var(--bg-card);
            border: 1px solid #2a3746;
            color: var(--text-light);
            padding: 10px 14px;
            border-radius: 8px;
            outline: none;
            transition: border-color 0.3s;
        }

        .search-input:focus {
            border-color: var(--neon-green);
        }

        .filter-btn {
            background: var(--bg-card);
            border: 1px solid #2a3746;
            color: var(--text-light);
            padding: 10px 14px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Сетка инвентаря */
        .inventory-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 80px; /* Отступ для кнопок */
        }

        /* Карточка скина */
        .skin-card {
            background: var(--bg-card);
            border: 1px solid var(--neon-green);
            border-radius: var(--border-radius);
            padding: 10px;
            position: relative;
            box-shadow: inset 0 0 10px rgba(74, 222, 128, 0.05), 0 0 10px rgba(0,0,0,0.5);
            transition: transform 0.2s;
            cursor: pointer;
        }

        .skin-card:active {
            transform: scale(0.97);
        }

        /* Кастомный чекбокс */
        .checkbox-container {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 20px;
            height: 20px;
            background: var(--bg-dark);
            border: 1px solid var(--text-muted);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .skin-card.selected {
            box-shadow: inset 0 0 20px var(--neon-glow), 0 0 15px var(--neon-glow);
        }

        .skin-card.selected .checkbox-container {
            border-color: var(--neon-green);
            background: var(--neon-green);
        }

        .skin-card.selected .checkbox-container::after {
            content: '✓';
            color: var(--bg-dark);
            font-size: 14px;
            font-weight: bold;
        }

        .skin-image {
            width: 100%;
            height: 80px;
            object-fit: contain;
            margin: 15px 0;
            filter: drop-shadow(0 5px 5px rgba(0,0,0,0.5));
        }

        .skin-name {
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .skin-exterior {
            font-size: 10px;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .skin-price {
            font-size: 16px;
            font-weight: 800;
            color: var(--text-light);
        }

        /* Кнопки действий (Footer) */
        .action-buttons {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 16px;
            background: linear-gradient(to top, var(--bg-dark) 80%, transparent);
            display: flex;
            gap: 12px;
            z-index: 10;
        }

        .btn {
            flex: 1;
            padding: 14px;
            border-radius: var(--border-radius);
            font-weight: 800;
            font-size: 14px;
            text-align: center;
            border: none;
            cursor: pointer;
            transition: opacity 0.2s;
            text-transform: uppercase;
        }

        .btn:active {
            opacity: 0.8;
        }

        .btn-secondary {
            background: transparent;
            border: 1px solid var(--text-muted);
            color: var(--text-light);
        }

        .btn-primary {
            background: var(--neon-green);
            color: var(--bg-dark);
            box-shadow: 0 0 20px var(--neon-glow);
        }

        /* Адаптация для планшетов/ПК */
        @media (min-width: 600px) {
            .inventory-grid { grid-template-columns: repeat(3, 1fr); }
            body { max-width: 800px; margin: 0 auto; }
        }
        @media (min-width: 900px) {
            .inventory-grid { grid-template-columns: repeat(4, 1fr); }
        }
    </style>
</head>
<body>

    <header class="header">
        <h1 class="title">Результаты оценки: CS2</h1>
        
        <div class="stats-container">
            <div class="stat-box">
                <div class="stat-title">Всего предметов:</div>
                <div class="stat-value" id="total-items">4</div>
            </div>
            <div class="stat-box">
                <div class="stat-title">Оценочная стоимость:</div>
                <div class="stat-value" id="total-price">~$203.95</div>
            </div>
        </div>

        <div class="controls">
            <div class="filter-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            </div>
            <input type="text" class="search-input" placeholder="Поиск скинов...">
        </div>
    </header>

    <main>
        <div class="inventory-grid" id="inventory">
            <!-- Карточка 1 -->
            <div class="skin-card selected" data-price="18.20">
                <div class="checkbox-container"></div>
                <img src="https://community.cloudflare.steamstatic.com/economy/image/-9a81dlWLwJ2UUGcVs_nsVtzdOEdtWwKGZZLQHTxDZ7I56KU0Zwwo4NUX4oFJZEHLbXH5ApeO4YmlhxYQknCRvCo04DEVlxkKgpot7HxfDhjxspJVj-zndzngwnXm_jmMoTck29Y_cg_3L-Qp42m2Ffj80Y_YzziJNCRI1c9M1-E-wK2w-m-gpW7tcjOznZhuXJz4X_eyxO21x4fau1mhQ/360fx360f" alt="AK-47" class="skin-image">
                <div class="skin-name">AK-47 | Hyper Beast</div>
                <div class="skin-exterior">Exterior: Field-Tested</div>
                <div class="skin-price">$18.20</div>
            </div>

            <!-- Карточка 2 -->
            <div class="skin-card selected" data-price="120.50">
                <div class="checkbox-container"></div>
                <img src="https://community.cloudflare.steamstatic.com/economy/image/-9a81dlWLwJ2UUGcVs_nsVtzdOEdtWwKGZZLQHTxDZ7I56KU0Zwwo4NUX4oFJZEHLbXH5ApeO4YmlhxYQknCRvCo04DEVlxkKgpovbMz18axcgL3fG1cwO-znYy0mvLwOq7c2DlQsccm0uiWoNmhiwG3rxVqazj1J9LGIVVoZVqC_lPsle-7g8C5uZXKzyFk7HUg-z-DyG2gE0g/360fx360f" alt="M9 Bayonet" class="skin-image">
                <div class="skin-name">M9 Bayonet | Fade</div>
                <div class="skin-exterior">Exterior: Factory New</div>
                <div class="skin-price">$120.50</div>
            </div>

            <!-- Карточка 3 -->
            <div class="skin-card selected" data-price="25.25">
                <div class="checkbox-container"></div>
                <img src="https://community.cloudflare.steamstatic.com/economy/image/-9a81dlWLwJ2UUGcVs_nsVtzdOEdtWwKGZZLQHTxDZ7I56KU0Zwwo4NUX4oFJZEHLbXH5ApeO4YmlhxYQknCRvCo04DEVlxkKgposbaqKAxf0Ob3djFN79eJmo-Cg_jmNqjUl2hU18l4jeHVu46t3Qbn-UNlN2vyIoWccAY6ZgqB-Vm2kP_sg8W6uJrNznV9-n51YgC-3A/360fx360f" alt="Glock-18" class="skin-image">
                <div class="skin-name">Glock-18 | Fade</div>
                <div class="skin-exterior">Exterior: Factory New</div>
                <div class="skin-price">$25.25</div>
            </div>

            <!-- Карточка 4 -->
            <div class="skin-card selected" data-price="40.00">
                <div class="checkbox-container"></div>
                <img src="https://community.cloudflare.steamstatic.com/economy/image/-9a81dlWLwJ2UUGcVs_nsVtzdOEdtWwKGZZLQHTxDZ7I56KU0Zwwo4NUX4oFJZEHLbXH5ApeO4YmlhxYQknCRvCo04DEVlxkKgpoo6m1FBRp3_bNdJQ09t-5q4yCnvnjMKjuj2xU18h0juDU-MKn0VKw8kVqZDr0I4OSJwZoM1GErwTqlejpjMLvucmbmHVnuj5iuygGlg6r/360fx360f" alt="USP-S" class="skin-image">
                <div class="skin-name">USP-S | Neo-Noir</div>
                <div class="skin-exterior">Exterior: Minimal Wear</div>
                <div class="skin-price">$40.00</div>
            </div>
        </div>
    </main>

    <div class="action-buttons">
        <button class="btn btn-secondary" onclick="closeWebApp()">Оценить другой</button>
        <button class="btn btn-primary" onclick="sellSkins()">Продать на Lis Skins</button>
    </div>

    <script>
        // Инициализация Telegram Web App
        let tg = window.Telegram.WebApp;
        
        // Расширяем приложение на всю высоту
        tg.expand();
        
        // Устанавливаем цвета под тему приложения
        tg.setHeaderColor('#0a0f14');
        tg.setBackgroundColor('#0a0f14');

        // Логика выделения карточек и пересчета суммы
        const cards = document.querySelectorAll('.skin-card');
        const totalPriceEl = document.getElementById('total-price');
        const totalItemsEl = document.getElementById('total-items');

        function updateStats() {
            let total = 0;
            let count = 0;
            
            cards.forEach(card => {
                if (card.classList.contains('selected')) {
                    total += parseFloat(card.getAttribute('data-price'));
                    count++;
                }
            });

            totalPriceEl.textContent = `~$${total.toFixed(2)}`;
            totalItemsEl.textContent = count;
        }

        // Обработчик клика по карточкам
        cards.forEach(card => {
            card.addEventListener('click', () => {
                card.classList.toggle('selected');
                // Добавляем вибрацию при нажатии (Haptic Feedback TWA)
                tg.HapticFeedback.selectionChanged();
                updateStats();
            });
        });

        // Функция закрытия приложения (кнопка "Оценить другой")
        function closeWebApp() {
            tg.close();
        }

        // Функция продажи
        function sellSkins() {
            // Отправка данных обратно в бота (например, список выбранных скинов)
            const selectedSkins = [];
            cards.forEach(card => {
                if (card.classList.contains('selected')) {
                    selectedSkins.push(card.querySelector('.skin-name').textContent);
                }
            });

            if (selectedSkins.length === 0) {
                tg.showAlert("Выберите хотя бы один скин для продажи!");
                return;
            }

            // Можно отправить данные в бота через tg.sendData(), если используем KeyboardButton
            // Но для Inline кнопок (Mini Apps) обычно делают API запрос к своему серверу.
            // Здесь мы просто перенаправим пользователя по реферальной ссылке
            
            tg.openLink("https://lis-skins.ru/?ref=ТВОЙ_АЙДИ");
        }
    </script>
</body>
</html>
